{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lkb-media-music",
  "main": "src/index.js",
  "compatibility_date": "2026-09-27",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lkb-media-music",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
